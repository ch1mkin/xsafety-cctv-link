{
  "rewrites": [
    { "source": "/go", "destination": "/go.html" },
    { "source": "/go/:room", "destination": "/go.html?room=:room" },
    { "source": "/watch", "destination": "/watch.html" },
    { "source": "/watch/:room", "destination": "/watch.html?room=:room" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=()"
        }
      ]
    }
  ]
}
