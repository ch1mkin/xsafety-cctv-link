{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/go/:room", "destination": "/go.html" },
    { "source": "/watch/:room", "destination": "/watch.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=()"
        }
      ]
    }
  ]
}
